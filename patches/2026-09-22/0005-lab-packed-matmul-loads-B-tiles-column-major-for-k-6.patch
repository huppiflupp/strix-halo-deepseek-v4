From 156d3127291616c7a9df2df290513490b89fa693 Mon Sep 17 00:00:00 2001
From: huppiflupp <144213886+huppiflupp@users.noreply.github.com>
Date: Tue, 22 Sep 2026 08:29:50 +0200
Subject: [PATCH 5/5] lab: packed matmul loads B tiles column-major for k <=
 6144 (GGML_VK_LAB_MM_BCOL, kernel-lab E039/E045)

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 ggml/src/ggml-vulkan/ggml-vulkan-types.h               |  2 +-
 ggml/src/ggml-vulkan/ggml-vulkan.cpp                   |  6 ++++++
 ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp   | 10 +++++++++-
 .../ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp  |  1 +
 4 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-types.h b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
index 16b457f9e..8b416fbaf 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-types.h
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
@@ -831,7 +831,7 @@ struct vk_device_struct {
 
     vk_pipeline pipeline_add_id_f32;
     vk_pipeline pipeline_lab_fa_kvpack;   // lab: tile-packed K/V scratch for prompt-phase attention
-    vk_pipeline pipeline_lab_mm_pack_f16, pipeline_lab_mm_pack_f32, pipeline_lab_mm_unpad_f32, pipeline_lab_mm_gemm;   // lab: packed dense matmul
+    vk_pipeline pipeline_lab_mm_pack_f16, pipeline_lab_mm_pack_f32, pipeline_lab_mm_unpad_f32, pipeline_lab_mm_gemm, pipeline_lab_mm_gemm_bcol, pipeline_lab_mm_pack_f32_col;   // lab: packed dense matmul
 
     vk_pipeline pipeline_concat_i8, pipeline_concat_i16, pipeline_concat_i32, pipeline_concat_i64, pipeline_concat_transpose_i32;
     vk_pipeline pipeline_upscale_nearest_f32, pipeline_upscale_bilinear_f32, pipeline_upscale_bicubic_f32, pipeline_upscale_bilinear_antialias_f32;
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index ef7d7ad5f..f60210118 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -3318,6 +3318,8 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         ggml_vk_create_pipeline(device, device->pipeline_lab_mm_pack_f32, "lab_mm_pack_f32", lab_mm_pack_f32_len, lab_mm_pack_f32_data, "main", 2, 4 * sizeof(uint32_t), {256, 1, 1}, {1}, 1);
         ggml_vk_create_pipeline(device, device->pipeline_lab_mm_unpad_f32, "lab_mm_unpad_f32", lab_mm_unpad_f32_len, lab_mm_unpad_f32_data, "main", 2, 4 * sizeof(uint32_t), {256, 1, 1}, {2}, 1);
         ggml_vk_create_pipeline(device, device->pipeline_lab_mm_gemm, "lab_mm_gemm", lab_mm_gemm_cm1_len, lab_mm_gemm_cm1_data, "main", 3, 4 * sizeof(uint32_t), {1, 1, 1}, {64, 4, 4}, 1, false, true, 64);
+        ggml_vk_create_pipeline(device, device->pipeline_lab_mm_gemm_bcol, "lab_mm_gemm_bcol", lab_mm_gemm_bcol_cm1_len, lab_mm_gemm_bcol_cm1_data, "main", 3, 4 * sizeof(uint32_t), {1, 1, 1}, {64, 4, 4}, 1, false, true, 64);
+        ggml_vk_create_pipeline(device, device->pipeline_lab_mm_pack_f32_col, "lab_mm_pack_f32_col", lab_mm_pack_f32_len, lab_mm_pack_f32_data, "main", 2, 4 * sizeof(uint32_t), {256, 1, 1}, {0}, 1);
     }
 #endif
 
@@ -6280,6 +6282,10 @@ static bool ggml_vk_lab_mul_mat_packed(ggml_backend_vk_context * ctx, vk_context
     if (ctx->prealloc_size_y < b_pk_sz) { ctx->prealloc_size_y = b_pk_sz; ggml_vk_preallocate_buffers(ctx, subctx); }
 
     vk_pipeline pack_a = ctx->device->pipeline_lab_mm_pack_f16, pack_b = ctx->device->pipeline_lab_mm_pack_f32, gemm = ctx->device->pipeline_lab_mm_gemm;
+    // lab E039/E045: B tiles stored untransposed and loaded column-major where that wins (k <= 6144: +3.5 % coder prompt, bit-identical;
+    // k = 17408 at 2048 tokens: -25 % in the prototype, so ffn_down keeps the row-major path). GGML_VK_LAB_MM_BCOL=1.
+    static const bool lab_bcol = getenv("GGML_VK_LAB_MM_BCOL") != nullptr;
+    if (lab_bcol && k <= 6144) { pack_b = ctx->device->pipeline_lab_mm_pack_f32_col; gemm = ctx->device->pipeline_lab_mm_gemm_bcol; }
     vk_pipeline unpad = ctx->device->pipeline_lab_mm_unpad_f32;
     if (!direct_store) { ggml_pipeline_request_descriptor_sets(ctx, unpad, 1); }
     if (to_fp16) { ggml_pipeline_request_descriptor_sets(ctx, to_fp16, 1); }
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp
index e2757ca04..e8b2446b8 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp
@@ -27,6 +27,14 @@ layout(push_constant) uniform parameter {
     uint pad;
 } p;
 
+// lab E039: RADV lowers B-use matrices as column vectors - a column-major load is cheaper (the pack shader then stores the
+// activation tiles transposed). Separate shader variant, not a spec constant (branches in the hot loop distort timings).
+#ifdef BCOL
+#define BLAYOUT gl_CooperativeMatrixLayoutColumnMajor
+#else
+#define BLAYOUT gl_CooperativeMatrixLayoutRowMajor
+#endif
+
 void main() {
     const uint gj = gl_WorkGroupID.x;   // token block
     const uint gi = gl_WorkGroupID.y;   // weight-row block
@@ -44,7 +52,7 @@ void main() {
             coopMatLoad(ma[r], data_a, ((gi * TR + r) * ktiles + kt) * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
         }
         [[unroll]] for (uint q = 0; q < TC; ++q) {
-            coopMatLoad(mb[q], data_b, ((gj * TC + q) * ktiles + kt) * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
+            coopMatLoad(mb[q], data_b, ((gj * TC + q) * ktiles + kt) * 256u, 16, BLAYOUT);
         }
         [[unroll]] for (uint r = 0; r < TR; ++r) {
             [[unroll]] for (uint q = 0; q < TC; ++q) {
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
index 41fb85b1d..80113165e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/vulkan-shaders-gen.cpp
@@ -1225,6 +1225,7 @@ void process_shaders() {
     string_to_spv("lab_mm_unpad_f32", "lab_mm_pack.comp", {{"SRC_TYPE", "float"}, {"DST_TYPE", "float"}});
 #if defined(GGML_VULKAN_COOPMAT_GLSLC_SUPPORT)
     string_to_spv("lab_mm_gemm", "lab_mm_gemm.comp", {}, true, true);
+    string_to_spv("lab_mm_gemm_bcol", "lab_mm_gemm.comp", {{"BCOL", "1"}}, true, true);
 #endif
 
     string_to_spv("add_id_f32", "add_id.comp", merge_maps(base_dict, {{"A_TYPE", "float"}, {"B_TYPE", "float"}, {"D_TYPE", "float"}}));
-- 
2.55.0

