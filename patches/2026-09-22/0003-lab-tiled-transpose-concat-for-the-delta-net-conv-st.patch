--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_fa_kvpack.comp
@@ -0,0 +1,30 @@
+#version 450
+
+// lab (strix-halo-kernel-lab E030): packs f16 K or V from the KV-cache layout into per-head 16x16 tiles, each tile one
+// contiguous run: [head][kv/16][hs/16][kv%16][hs%16]. Same size as the plain per-head contiguous scratch.
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+layout(binding = 0, std430) readonly buffer S { float16_t data_s[]; };
+layout(binding = 1, std430) writeonly buffer D { float16_t data_d[]; };
+layout(push_constant) uniform parameter {
+    uint hs;       // head size
+    uint kv;       // cached tokens (multiple of 16)
+    uint nb1;      // source stride between tokens, in elements
+    uint nb2;      // source stride between heads, in elements
+    uint count;    // hs * kv * heads
+    uint colmajor; // 1: inside a tile the hs index is the slow one (for ColumnMajor loads of B-use matrices)
+    uint pad1, pad2;
+} p;
+
+void main() {
+    const uint e = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 8388608u;
+    if (e >= p.count) {
+        return;
+    }
+    const uint hst = p.hs / 16u, kvt = p.kv / 16u;
+    const uint tile = e / 256u, r = (e % 256u) / 16u, c = e % 16u;
+    const uint ht = tile % hst, kt = (tile / hst) % kvt, head = tile / (hst * kvt);
+    const uint ih = p.colmajor != 0u ? r : c, ik = p.colmajor != 0u ? c : r;
+    data_d[e] = data_s[(ht * 16u + ih) + (kt * 16u + ik) * p.nb1 + head * p.nb2];
+}
