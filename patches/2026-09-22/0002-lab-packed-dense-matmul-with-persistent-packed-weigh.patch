+        ggml_vk_create_pipeline(device, device->pipeline_lab_mm_pack_f32, "lab_mm_pack_f32", lab_mm_pack_f32_len, lab_mm_pack_f32_data, "main", 2, 4 * sizeof(uint32_t), {256, 1, 1}, {1}, 1);
+        ggml_vk_create_pipeline(device, device->pipeline_lab_mm_unpad_f32, "lab_mm_unpad_f32", lab_mm_unpad_f32_len, lab_mm_unpad_f32_data, "main", 2, 4 * sizeof(uint32_t), {256, 1, 1}, {2}, 1);
+        ggml_vk_create_pipeline(device, device->pipeline_lab_mm_gemm, "lab_mm_gemm", lab_mm_gemm_cm1_len, lab_mm_gemm_cm1_data, "main", 3, 4 * sizeof(uint32_t), {1, 1, 1}, {64, 4, 4}, 1, false, true, 64);
+    }
+#endif
+
     ggml_vk_create_pipeline(device, device->pipeline_acc_f32, "acc_f32", acc_f32_len, acc_f32_data, "main", 3, sizeof(vk_op_binary_push_constants), {512, 1, 1}, {0, 1}, 1);
     ggml_vk_create_pipeline(device, device->pipeline_set_f32, "set_f32", acc_f32_len, acc_f32_data, "main", 3, sizeof(vk_op_binary_push_constants), {512, 1, 1}, {0, 0}, 1);
 
@@ -6179,11 +6190,159 @@ static vk_pipeline ggml_vk_get_64b_indexing_pipeline(ggml_backend_vk_context * c
     return pipeline;
 }
 
+// lab (strix-halo-kernel-lab E020/E021): dense matmul with operands packed tile by tile, see lab_mm_gemm.comp.
+// Returns false if the case is not covered (the caller then takes the normal path).
+static bool ggml_vk_lab_mul_mat_packed(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    // GGML_VK_LAB_MM_PACKED=1: weights are dequantised + packed on every call;
+    //                       =2: the packed f16 copy of each weight matrix is built once and kept ("persistent"),
+    //                           up to GGML_VK_LAB_MM_CACHE_MB (default 60000) - the way Marlin/Machete re-lay weights at load.
+    static const bool dbg = getenv("GGML_VK_LAB_MM_DEBUG") != nullptr;
+    static const int lab_mode = [] { const char * e = getenv("GGML_VK_LAB_MM_PACKED"); return e ? atoi(e) : 0; }();
+    static const uint64_t cache_limit = [] { const char * e = getenv("GGML_VK_LAB_MM_CACHE_MB"); return uint64_t(e ? atoll(e) : 60000) << 20; }();
+    const bool enabled = lab_mode != 0;
+    if (!enabled || ctx->device->pipeline_lab_mm_gemm == nullptr) {
+        if (dbg) { fprintf(stderr, "lab_mm: REJECT %s %s m=%d k=%d n=%d\n", "disabled", src0->name, (int) src0->ne[1], (int) src0->ne[0], (int) src1->ne[1]); }
+        return false;
+    }
+    const uint64_t k = src0->ne[0], m = src0->ne[1], n = src1->ne[1];
+    if (dbg && n >= 64) {
+        fprintf(stderr, "lab_mm: %s %s m=%d k=%d n=%d ne12=%d src1=%s dst=%s contig=%d%d%d\n", src0->name, ggml_type_name(src0->type), (int) m, (int) k, (int) n, (int) src1->ne[2],
+                ggml_type_name(src1->type), ggml_type_name(dst->type), ggml_is_contiguous(src0), ggml_is_contiguous(src1), ggml_is_contiguous(dst));
+    }
+    if (src0->ne[2] != 1 || src0->ne[3] != 1 || src1->ne[2] != 1 || src1->ne[3] != 1 || src1->ne[0] != (int64_t) k ||
+        k % 16 != 0 || n < 64 ||
+        src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(src0) || !ggml_is_contiguous(src1) || !ggml_is_contiguous(dst) ||
+        src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_BF16) {
+        if (dbg) { fprintf(stderr, "lab_mm: REJECT %s %s m=%d k=%d n=%d\n", "shape/type", src0->name, (int) src0->ne[1], (int) src0->ne[0], (int) src1->ne[1]); }
+        return false;
+    }
+    const bool a_is_f16 = src0->type == GGML_TYPE_F16;
+    vk_pipeline to_fp16 = a_is_f16 ? nullptr : ggml_vk_get_to_fp16(ctx, src0->type);
+    if (!a_is_f16 && to_fp16 == nullptr) {
+        if (dbg) { fprintf(stderr, "lab_mm: REJECT %s %s m=%d k=%d n=%d\n", "no-to_fp16", src0->name, (int) src0->ne[1], (int) src0->ne[0], (int) src1->ne[1]); }
+        return false;
+    }
+    const uint64_t a_f16_sz = m * k * sizeof(ggml_fp16_t);                 // dequantised weights, row-major
+    const uint64_t mP = ROUNDUP_POW2(m, 64), nP = ROUNDUP_POW2(n, 64);      // the kernel works on whole 4x4 tile blocks; padding is zeros
+    const uint64_t a_pk_sz  = mP * k * sizeof(ggml_fp16_t);                // packed weights
+    const uint64_t a_pk_off = a_is_f16 ? 0 : ROUNDUP_POW2(a_f16_sz, 256);
+    const uint64_t b_pk_sz  = nP * k * sizeof(ggml_fp16_t);
+    const uint64_t x_need = a_pk_off + a_pk_sz;
+    const uint64_t maxrange = ctx->device->properties.limits.maxStorageBufferRange;
+    if (x_need > maxrange || b_pk_sz > maxrange || mP * k > UINT32_MAX || nP * k > UINT32_MAX || nP * mP > UINT32_MAX) {
+        if (dbg) { fprintf(stderr, "lab_mm: REJECT %s %s m=%d k=%d n=%d\n", "too-large", src0->name, (int) src0->ne[1], (int) src0->ne[0], (int) src1->ne[1]); }
+        return false;
+    }
+
+    ggml_backend_vk_buffer_context * dst_buf_ctx  = (ggml_backend_vk_buffer_context *)dst->buffer->context;
+    ggml_backend_vk_buffer_context * src0_buf_ctx = (ggml_backend_vk_buffer_context *)src0->buffer->context;
+    ggml_backend_vk_buffer_context * src1_buf_ctx = (ggml_backend_vk_buffer_context *)src1->buffer->context;
+    vk_buffer d_Qx = nullptr, d_Qy = nullptr; size_t qx_off = 0, qy_off = 0;
+    if (ctx->device->uma) {
+        ggml_vk_host_get(ctx->device, src0->data, d_Qx, qx_off);
+        ggml_vk_host_get(ctx->device, src1->data, d_Qy, qy_off);
+    }
+    if (d_Qx == nullptr) { d_Qx = src0_buf_ctx->dev_buffer; qx_off = vk_tensor_offset(src0) + src0->view_offs; }
+    if (d_Qy == nullptr) { d_Qy = src1_buf_ctx->dev_buffer; qy_off = vk_tensor_offset(src1) + src1->view_offs; }
+    vk_buffer d_D = dst_buf_ctx->dev_buffer; const uint64_t d_off = vk_tensor_offset(dst) + dst->view_offs;
+    // sources are read element-wise by the pack shaders: the device's offset alignment is enough.
+    // dst is written with coopMatStore, which needs a 16-byte aligned pointer.
+    const uint64_t src_align = ctx->device->properties.limits.minStorageBufferOffsetAlignment;
+    const uint64_t align = std::max<uint64_t>(16, src_align);
+    // a dst that is not 16-byte aligned cannot take a coopMatStore: multiply into a scratch, then copy (GPU memcpy)
+    const bool direct_store = d_off % align == 0 && mP == m && nP == n;
+    const uint64_t d_sz = n * m * sizeof(float);
+    const uint64_t c_sz = nP * mP * sizeof(float);                        // padded result scratch
+    if (qx_off % src_align != 0 || qy_off % src_align != 0) {
+        if (dbg) { fprintf(stderr, "lab_mm: reject alignment qx=%zu qy=%zu d=%zu\n", (size_t) qx_off, (size_t) qy_off, (size_t) d_off); }
+        if (dbg) { fprintf(stderr, "lab_mm: REJECT alignment qx%%16=%d qy%%16=%d d%%16=%d src_align=%d\n", (int) (qx_off % 16), (int) (qy_off % 16), (int) (d_off % 16), (int) src_align); }
+        return false;   // coopMatStore / the pack shaders index from the start of the bound range
+    }
+
+    // persistent copy: only for real weights, and only while the budget lasts
+    vk_buffer a_persist = nullptr; bool a_persist_ready = false;
+    if (lab_mode >= 2 && src0->buffer && ggml_backend_buffer_get_usage(src0->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+        auto it = ctx->lab_packed_weights.find((const void *) src0);
+        if (it != ctx->lab_packed_weights.end() && it->second->size >= a_pk_sz) {
+            a_persist = it->second; a_persist_ready = true;
+        } else if (ctx->lab_packed_bytes + a_pk_sz <= cache_limit) {
+            a_persist = ggml_vk_create_buffer_device(ctx->device, a_pk_sz);
+            ctx->lab_packed_weights[(const void *) src0] = a_persist;
+            ctx->lab_packed_bytes += a_pk_sz;
+        }
+    }
+
+    if (!direct_store && ctx->prealloc_size_split_k < c_sz) { ctx->prealloc_size_split_k = c_sz; ggml_vk_preallocate_buffers(ctx, subctx); }
+    if (!a_persist_ready && ctx->prealloc_size_x < x_need) { ctx->prealloc_size_x = x_need; ggml_vk_preallocate_buffers(ctx, subctx); }
+    if (ctx->prealloc_size_y < b_pk_sz) { ctx->prealloc_size_y = b_pk_sz; ggml_vk_preallocate_buffers(ctx, subctx); }
+
+    vk_pipeline pack_a = ctx->device->pipeline_lab_mm_pack_f16, pack_b = ctx->device->pipeline_lab_mm_pack_f32, gemm = ctx->device->pipeline_lab_mm_gemm;
+    vk_pipeline unpad = ctx->device->pipeline_lab_mm_unpad_f32;
+    if (!direct_store) { ggml_pipeline_request_descriptor_sets(ctx, unpad, 1); }
+    if (to_fp16) { ggml_pipeline_request_descriptor_sets(ctx, to_fp16, 1); }
+    ggml_pipeline_request_descriptor_sets(ctx, pack_a, 1);
+    ggml_pipeline_request_descriptor_sets(ctx, pack_b, 1);
+    ggml_pipeline_request_descriptor_sets(ctx, gemm, 1);
+
+    auto pack_elems = [](uint64_t count) -> std::array<uint32_t, 3> {
+        return { (uint32_t) std::min<uint64_t>(count, 8388608), (uint32_t) CEIL_DIV(count, 8388608), 1 };
+    };
+
+    if (!direct_store && ctx->prealloc_split_k_need_sync) { ggml_vk_sync_buffers(ctx, subctx); }
+    // weights: (dequantise ->) pack; skipped when a persistent packed copy exists
+    const vk_subbuffer a_packed = a_persist ? vk_subbuffer{ a_persist, 0, a_pk_sz } : vk_subbuffer{ ctx->prealloc_x, a_pk_off, a_pk_sz };
+    if (!a_persist_ready && ctx->prealloc_x_need_sync) { ggml_vk_sync_buffers(ctx, subctx); }
+    const uint64_t qx_sz = ggml_nbytes(src0);
+    if (!a_persist_ready && to_fp16) {
+        const std::vector<uint32_t> pc = { (uint32_t) m, (uint32_t) k, (uint32_t) k, (uint32_t) k, (uint32_t) (m * k) };
+        ggml_vk_dispatch_pipeline(ctx, subctx, to_fp16, { vk_subbuffer{ d_Qx, qx_off, qx_sz }, vk_subbuffer{ ctx->prealloc_x, 0, a_f16_sz } }, pc, { (uint32_t) (m * k), 1, 1 });
+        ggml_vk_sync_buffers(ctx, subctx);
+    }
+    if (!a_persist_ready) {
+        const std::array<uint32_t, 4> pc = { (uint32_t) k, (uint32_t) (k / 16), (uint32_t) (mP * k), (uint32_t) m };
+        const vk_subbuffer a_src = to_fp16 ? vk_subbuffer{ ctx->prealloc_x, 0, a_f16_sz } : vk_subbuffer{ d_Qx, qx_off, qx_sz };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pack_a, { a_src, a_packed }, pc, pack_elems(mP * k));
+    }
+    // activations: packed once per distinct input tensor (q/k/v and gate/up share theirs)
+    static const bool no_reuse = getenv("GGML_VK_LAB_MM_NOREUSE") != nullptr;
+    if (no_reuse || ctx->prealloc_y_last_pipeline_used != pack_b.get() || ctx->prealloc_y_last_tensor_used != src1) {
+        if (ctx->prealloc_y_need_sync) { ggml_vk_sync_buffers(ctx, subctx); }
+        const std::array<uint32_t, 4> pc = { (uint32_t) k, (uint32_t) (k / 16), (uint32_t) (nP * k), (uint32_t) n };
+        ggml_vk_dispatch_pipeline(ctx, subctx, pack_b, { vk_subbuffer{ d_Qy, qy_off, n * k * sizeof(float) }, vk_subbuffer{ ctx->prealloc_y, 0, b_pk_sz } }, pc, pack_elems(nP * k));
+        ctx->prealloc_y_last_pipeline_used = pack_b.get();
+        ctx->prealloc_y_last_tensor_used = src1;
+        ctx->prealloc_y_last_k_padded = false;
+    }
+    ggml_vk_sync_buffers(ctx, subctx);
+
+    const std::array<uint32_t, 4> pc = { (uint32_t) mP, (uint32_t) k, (uint32_t) nP, 0 };
+    ggml_vk_dispatch_pipeline(ctx, subctx, gemm,
+        { a_packed, vk_subbuffer{ ctx->prealloc_y, 0, b_pk_sz }, direct_store ? vk_subbuffer{ d_D, d_off, d_sz } : vk_subbuffer{ ctx->prealloc_split_k, 0, c_sz } },
+        pc, { (uint32_t) (nP / 64), (uint32_t) (mP / 64), 1 });
+
+    if (!direct_store) {
+        ggml_vk_sync_buffers(ctx, subctx);
+        // compute-shader copy (same queue, covered by the compute barrier) out of the padded scratch: dst[j*m + i] = c[j*mP + i]
+        const std::array<uint32_t, 4> pcu = { (uint32_t) m, (uint32_t) mP, (uint32_t) (n * m), 0 };
+        ggml_vk_dispatch_pipeline(ctx, subctx, unpad, { vk_subbuffer{ ctx->prealloc_split_k, 0, c_sz }, vk_subbuffer{ d_D, d_off, d_sz } }, pcu, pack_elems(n * m));
+        ctx->prealloc_split_k_need_sync = true;
+    }
+    if (dbg) { fprintf(stderr, "lab_mm: TAKEN %s %s\n", a_persist_ready ? "cache-hit" : (a_persist ? "cache-new" : "per-call"), src0->name); }
+    if (!a_persist_ready) { ctx->prealloc_x_need_sync = true; }
+    ctx->prealloc_y_need_sync = true;
+    return true;
+}
+
 static void ggml_vk_mul_mat_q_f16(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst, bool disable_split_k) {
     VK_LOG_DEBUG("ggml_vk_mul_mat_q_f16((" << src0 << ", name=" << src0->name << ", type=" << ggml_type_name(src0->type) << ", ne0=" << src0->ne[0] << ", ne1=" << src0->ne[1] << ", ne2=" << src0->ne[2] << ", ne3=" << src0->ne[3] << ", nb0=" << src0->nb[0] << ", nb1=" << src0->nb[1] << ", nb2=" << src0->nb[2] << ", nb3=" << src0->nb[3];
     std::cerr << "), (" << src1 << ", name=" << src1->name << ", type=" << ggml_type_name(src1->type) << ", ne0=" << src1->ne[0] << ", ne1=" << src1->ne[1] << ", ne2=" << src1->ne[2] << ", ne3=" << src1->ne[3] << ", nb0=" << src1->nb[0] << ", nb1=" << src1->nb[1] << ", nb2=" << src1->nb[2] << ", nb3=" << src1->nb[3];
     std::cerr << "), (" << dst << ", name=" << dst->name << ", type=" << ggml_type_name(dst->type) << ", ne0=" << dst->ne[0] << ", ne1=" << dst->ne[1] << ", ne2=" << dst->ne[2] << ", ne3=" << dst->ne[3] << ", nb0=" << dst->nb[0] << ", nb1=" << dst->nb[1] << ", nb2=" << dst->nb[2] << ", nb3=" << dst->nb[3];
     std::cerr << "))");
+    if (ggml_vk_lab_mul_mat_packed(ctx, subctx, src0, src1, dst)) {
+        return;
+    }
+
     GGML_ASSERT(ggml_vk_dim01_contiguous(src0) || src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16);  // NOLINT
     GGML_ASSERT(ggml_vk_dim01_contiguous(src1) || src1->type == GGML_TYPE_F32 || src1->type == GGML_TYPE_F16);  // NOLINT
 
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp
new file mode 100644
index 000000000..e2757ca04
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_gemm.comp
@@ -0,0 +1,61 @@
+#version 450
+
+// lab (strix-halo-kernel-lab E020/E021): dense matmul on the 16x16x16 cooperative-matrix multiply-add with
+//  - operands packed once per call, tile by tile (lab_mm_pack.comp), loaded with stride 16,
+//  - TR x TC output tiles per wave: TR + TC tile loads per TR*TC multiply-adds,
+//  - work-groups ordered weight-block-major (x = token block, y = weight-row block), so a block of weight rows
+//    is reused for all tokens while the packed activations stay in the GPU's L3 cache,
+//  - the result stored directly in the consumer's layout dst[token][row] (f32).
+// Requires rows % (16*TR) == 0, tokens % (16*TC) == 0, k % 16 == 0 (the host falls back otherwise).
+#extension GL_EXT_control_flow_attributes : enable
+#extension GL_KHR_cooperative_matrix : enable
+#extension GL_KHR_memory_scope_semantics : enable
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+layout(constant_id = 1) const uint TR = 4;
+layout(constant_id = 2) const uint TC = 4;
+
+layout(binding = 0, std430) readonly buffer A { float16_t data_a[]; };
+layout(binding = 1, std430) readonly buffer B { float16_t data_b[]; };
+layout(binding = 2, std430) writeonly buffer D { float data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint m;   // weight rows = output features
+    uint k;   // inner dimension
+    uint n;   // tokens
+    uint pad;
+} p;
+
+void main() {
+    const uint gj = gl_WorkGroupID.x;   // token block
+    const uint gi = gl_WorkGroupID.y;   // weight-row block
+    const uint ktiles = p.k / 16u;
+
+    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[TR];
+    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[TC];
+    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> sums[TR * TC];
+    [[unroll]] for (uint t = 0; t < TR * TC; ++t) {
+        sums[t] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
+    }
+
+    for (uint kt = 0; kt < ktiles; ++kt) {
+        [[unroll]] for (uint r = 0; r < TR; ++r) {
+            coopMatLoad(ma[r], data_a, ((gi * TR + r) * ktiles + kt) * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
+        }
+        [[unroll]] for (uint q = 0; q < TC; ++q) {
+            coopMatLoad(mb[q], data_b, ((gj * TC + q) * ktiles + kt) * 256u, 16, gl_CooperativeMatrixLayoutRowMajor);
+        }
+        [[unroll]] for (uint r = 0; r < TR; ++r) {
+            [[unroll]] for (uint q = 0; q < TC; ++q) {
+                sums[r * TC + q] = coopMatMulAdd(ma[r], mb[q], sums[r * TC + q]);
+            }
+        }
+    }
+
+    [[unroll]] for (uint r = 0; r < TR; ++r) {
+        [[unroll]] for (uint q = 0; q < TC; ++q) {
+            coopMatStore(sums[r * TC + q], data_d, ((gj * TC + q) * 16u) * p.m + (gi * TR + r) * 16u, p.m, gl_CooperativeMatrixLayoutColumnMajor);
+        }
+    }
+}
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_pack.comp b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_pack.comp
new file mode 100644
index 000000000..c8084e4ba
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/lab_mm_pack.comp
@@ -0,0 +1,40 @@
+#version 450
+
+// lab (strix-halo-kernel-lab E020/E021): packs a matmul operand tile by tile, each 16x16 tile contiguous.
+// TRANSPOSED == 0: weights  [rows][k] -> tile (row/16, k/16), inside the tile rows = weight rows, cols = k
+// TRANSPOSED == 1: activations [tokens][k] -> tile (token/16, k/16), inside the tile rows = k, cols = tokens
+// TRANSPOSED == 2: plain row copy src[j * ktiles + i] -> dst[j * k + i] (result out of the padded scratch)
+// Source rows >= p.rows are padding and packed as zeros.
+#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+layout(constant_id = 0) const uint TRANSPOSED = 0;
+
+layout(binding = 0, std430) readonly buffer S { SRC_TYPE data_s[]; };
+layout(binding = 1, std430) writeonly buffer D { DST_TYPE data_d[]; };
+
+layout(push_constant) uniform parameter {
+    uint k;        // elements per source row
+    uint ktiles;   // k / 16
+    uint count;    // number of packed elements
+    uint rows;     // valid source rows (the packed operand may be padded to a multiple of 64 rows)
+} p;
+
+void main() {
+    const uint e = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 8388608u;
+    if (e >= p.count) {
+        return;
+    }
+    if (TRANSPOSED == 2u) {
+        data_d[e] = DST_TYPE(data_s[(e / p.k) * p.ktiles + (e % p.k)]);
+        return;
+    }
+    const uint tile = e / 256u;
+    const uint r = (e % 256u) / 16u;
+    const uint c = e % 16u;
+    const uint o  = tile / p.ktiles;
+    const uint kt = tile % p.ktiles;
+    const uint row = o * 16u + (TRANSPOSED != 0u ? c : r);
+    const uint col = kt * 16u + (TRANSPOSED != 0u ? r : c);
+    data_d[e] = row < p.rows ? DST_TYPE(data_s[row * p.k + col]) : DST_TYPE(0.0);
+}
